{
    "name": "vue3-ts-template",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.20.0",
    "engines": {
        "node": ">=20.19.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "pnpm typecheck && vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint . --fix",
        "lint:check": "eslint . --max-warnings=0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest",
        "test:run": "vitest run",
        "check": "pnpm typecheck && pnpm lint:check && pnpm test:run",
        "postinstall": "patch-package"
    },
    "dependencies": {
        "@vueuse/core": "^14.1.0",
        "dayjs": "^1.11.19",
        "echarts": "^6.0.0",
        "mitt": "^3.0.1",
        "naive-ui": "2.41.0",
        "pinia": "^3.0.4",
        "remixicon": "^4.9.1",
        "umi-request": "^1.4.0",
        "vfonts": "^0.0.3",
        "vue": "^3.5.24",
        "vue-i18n": "^9.14.5",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitejs/plugin-vue-jsx": "^5.1.3",
        "@vue/eslint-config-typescript": "^14.0.0",
        "@vue/tsconfig": "^0.8.1",
        "autoprefixer": "^10.4.23",
        "eslint": "^9.0.0",
        "eslint-plugin-vue": "^9.30.0",
        "jsdom": "26.1.0",
        "less": "^4.5.1",
        "patch-package": "^8.0.1",
        "postcss": "^8.5.6",
        "prettier": "^3.4.0",
        "tailwindcss": "^3.4.17",
        "terser": "^5.44.1",
        "unplugin-vue-components": "^28.0.0",
        "vite": "npm:rolldown-vite@7.2.5",
        "vite-plugin-compression": "^0.5.1",
        "vitest": "^4.0.0",
        "vue-tsc": "^3.1.4"
    },
    "pnpm": {
        "overrides": {
            "vite": "npm:rolldown-vite@7.2.5"
        }
    }
}
