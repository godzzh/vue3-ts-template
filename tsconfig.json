{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "types": ["vite/client"],
        "noEmit": true,
        "strict": true,
        "allowJs": false,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "useUnknownInCatchVariables": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "src/**/*.json",
        "vite.config.ts",
        "tailwind.config.ts",
        "postcss.config.ts",
        "vitest.config.ts"
    ]
}
